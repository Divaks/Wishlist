# Copy to .env and adjust
# Generate a unique secret with openssl rand -hex 32
JWT_SECRET=
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=wishlist
CORS_ORIGIN=http://localhost:3000

# Server-side settings for wish photo uploads (both required to enable uploads)
WISH_PHOTO_BUCKET=wishlist-photo-bucket
WISH_PHOTO_REGION=eu-north-1
